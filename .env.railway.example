# ============================================================
# PeakPulse AI — Railway environment variables
# Paste these into Railway → Service → Variables (Raw Editor).
#
# IMPORTANT: configs/live.yaml wins over duplicate env values
# (see load_runtime_settings in src/dao_vang/config/settings.py).
# Anything already set in live.yaml — paths, web.public_url, scanner.*,
# research_v3_*, updater.*, coingecko/binance_agent_os — must be changed in
# live.yaml; setting it here has no effect. Only secrets and fields absent
# from live.yaml belong in this file.
# ============================================================

# --- Runtime ---
TZ=Asia/Taipei
DAO_VANG_CONFIG_PATH=configs/live.yaml
# api_server.py binds a fixed port 8000; set Railway's target port to 8000.
PORT=8000

# Mount a Railway Volume at /app/data_live (live.yaml paths.data_dir).
# Without it, DuckDB/Parquet history is wiped on every redeploy.

# DuckDB resource limits — keep below the Railway plan's RAM.
DAO_VANG_DUCKDB_MEMORY_LIMIT=1GB
DAO_VANG_DUCKDB_THREADS=2

# --- REQUIRED: dashboard access password (server fails closed without it) ---
DAO_VANG_WEB__ACCESS_PASSWORD=

# --- Telegram alerts (optional, recommended) ---
DAO_VANG_TELEGRAM__BOT_TOKEN=
DAO_VANG_TELEGRAM__CHAT_ID=

# --- Binance API (optional; public endpoints are enough for scanning) ---
# If set, use a READ-ONLY key. src/dao_vang/execution can place orders.
DAO_VANG_API_KEY=
DAO_VANG_API_SECRET=

# --- AI assistant chat panel (optional, NOT needed for scanning) ---
# Leave AI__API_KEY empty to use the built-in rule-based answers.
# If you set a key, ALWAYS override BASE_URL too — the default points to the
# original author's proxy (proxy-ai.comaygiauco.com) and would receive your key.
DAO_VANG_AI__ENABLED=true
DAO_VANG_AI__PROVIDER=openai
DAO_VANG_AI__API_KEY=
DAO_VANG_AI__BASE_URL=https://api.openai.com/v1
DAO_VANG_AI__MODEL_ID=gpt-4o-mini

# ------------------------------------------------------------
# Edit in configs/live.yaml before deploying (env cannot override):
#   web.public_url                -> your Railway domain (Telegram deep links)
#   research_v3_enabled           -> false (its model file is not in Git)
#   research_v3_telegram_enabled  -> false
#   updater.enabled               -> keep false (already false; no .git in image)
# ------------------------------------------------------------
